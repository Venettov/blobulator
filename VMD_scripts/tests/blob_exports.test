# Run with: vmd -dispdev text -e tests/blob_exports.test
# VMD reads -e files command by command. Keep the suite in one command so the
# renderer's event processing cannot read later tests while a test is running.
namespace eval :: {
package require tcltest 2
namespace import ::tcltest::test
::tcltest::configure -verbose {start pass error}
set scriptDir [file dirname [file dirname [file normalize [info script]]]]
set originalDir [pwd]
cd $scriptDir
source Blob_GUI.tcl
set ::blobulator::blobs .blob
set ::dialogMessage ""
proc tk_messageBox {args} {
    set ::dialogMessage [lindex $args [expr {[lsearch -exact $args -message] + 1}]]
    return ok
}
proc tk_getSaveFile {args} {return $::saveFilename}
set exportDir [::tcltest::makeDirectory blob_export_test_output]

proc exportFixture {{chains {A}} {extraResidue ""} {withInsertion 0}} {
    set pdb ""
    set serial 0
    set chainOffset 0.0
    foreach chain $chains {
        set resid 0
        foreach resname [concat {LEU LEU LEU LEU GLU GLU SER SER LEU LEU LEU LEU} $extraResidue] {
            incr resid
            set insertion " "
            if {$withInsertion && $resid == 6} {set insertion A}
            foreach {name element dx dy} {N N 0.0 0.0 CA C 1.4 0.0 C C 2.8 0.0 O O 3.0 1.2} {
                incr serial
                set x [expr {3.8 * ($resid - 1) + $dx}]
                append pdb [format "ATOM  %5d %-4s %3s %s%4d%1s   %8.3f%8.3f%8.3f%6.2f%6.2f          %2s\n" \
                    $serial $name $resname $chain $resid $insertion $x [expr {$dy + $chainOffset}] 0.0 1.0 0.0 $element]
            }
        }
        append pdb "TER\n"
        set chainOffset [expr {$chainOffset + 50.0}]
    }
    append pdb "END\n"
    set path [::tcltest::makeFile $pdb export_fixture.pdb]
    set molid [mol new $path type pdb waitfor all]
    ::tcltest::removeFile export_fixture.pdb
    set sel [atomselect $molid all]
    animate dup frame 0 $molid
    $sel frame 1
    $sel moveby {0 2 0}
    $sel delete
    set ::blobulator::MolID $molid
    set ::blobulator::Lmin 4
    set ::blobulator::H .4
    set ::blobulator::hydropathyScaleDictionaryList Kyte-Doolittle
    set ::blobulator::select protein
    set ::blobulator::graphRepOptions "Blob ID"
    set ::blobulator::trajectorySmoothing 0
    set ::blobulator::smoothingWindow 0
    blobulation
    return $molid
}
proc exportRead {path {binary 0}} {
    set f [open $path r]
    fconfigure $f -encoding utf-8
    if {$binary} {fconfigure $f -translation binary -encoding binary}
    set contents [read $f]
    close $f
    return $contents
}
proc exportCleanup {} {
    foreach molid [molinfo list] {mol delete $molid}
    array unset ::blobulator::blobRepNames
    array unset ::blobulator::blobulationParameters
    foreach path [glob -nocomplain -directory $::exportDir * .blobulator-*] {file delete $path}
}

test export-1.1 {export requires known blobulation provenance} -body {
    set ::blobulator::MolID [mol new]
    set target [file join $::exportDir not_created.csv]
    list [catch {::blobulator::exportBlobCSV $target}] [file exists $target]
} -cleanup {exportCleanup} -result {1 0}

test export-1.2 {CSV contains one row per residue and applied parameters} -setup {
    exportFixture
} -body {
    set ::blobulator::H .95
    set ::blobulator::Lmin 99
    set ::blobulator::select {resid 1}
    set ::blobulator::hydropathyScaleDictionaryList Moon-Fleming
    set ::blobulator::smoothingWindow unfinished
    set target [file join $::exportDir applied.csv]
    set count [::blobulator::exportBlobCSV $target]
    set csv [exportRead $target]
    list $count [llength [split [string trimright $csv \n] \n]] \
        [string match {*"Kyte-Doolittle",".4","4","0"*} $csv] \
        [string match {*"protein"*} $csv]
} -cleanup {exportCleanup} -result {12 13 1 1}

test export-1.3 {CSV respects the applied residue selection} -setup {
    exportFixture {A B}
} -body {
    set ::blobulator::select {chain B and resid 2 to 5}
    blobulation
    set target [file join $::exportDir subset.csv]
    ::blobulator::exportBlobCSV $target
} -cleanup {exportCleanup} -result 4

test export-1.4 {chains with repeated residue numbers remain distinct} -setup {
    exportFixture {A B}
} -body {
    ::blobulator::exportBlobCSV [file join $::exportDir multichain.csv]
} -cleanup {exportCleanup} -result 24

test export-1.5 {noncanonical protein residues are explicitly unassigned} -setup {
    exportFixture {A} HSE
} -body {
    set target [file join $::exportDir noncanonical.csv]
    set count [::blobulator::exportBlobCSV $target]
    list $count [string match {*"HSE","unassigned",""*} [exportRead $target]]
} -cleanup {exportCleanup} -result {13 1}

test export-1.6 {CSV quotes commas, quotes and newlines and preserves UTF-8} -setup {
    set molid [exportFixture]
} -body {
    mol rename $molid "peptide, \"A\"\n\u03b1"
    set target [file join $::exportDir escaped.csv]
    ::blobulator::exportBlobCSV $target
    set csv [exportRead $target]
    list [string match "*\"peptide, \"\"A\"\"\n\u03b1\"*" $csv] \
        [expr {[string first [encoding convertto utf-8 "\"peptide, \"\"A\"\"\n\u03b1\""] [exportRead $target 1]] >= 0}] \
        [expr {[string first \r\n [exportRead $target 1]] >= 0}]
} -cleanup {exportCleanup} -result {1 1 1}

test export-1.7 {selected molecule, current frame and actual smoothing are exported} -setup {
    set first [exportFixture]
    set ::blobulator::smoothingWindow 3
    ::blobulator::applyTrajectorySmoothing
    mol smoothrep $first 0 5
    molinfo $first set frame 1
    set second [exportFixture]
    set ::blobulator::MolID $first
} -body {
    set context [::blobulator::exportContext]
    list [expr {[dict get $context molid] == $first}] [dict get $context frame] \
        [dict get $context smoothing] [molinfo top get id]
} -cleanup {exportCleanup} -match glob -result {1 1 {3;5} *}

test export-1.8 {existing files require explicit overwrite and survive failure} -setup {
    exportFixture
    set target [file join $::exportDir existing.csv]
    set f [open $target w]; puts -nonewline $f original; close $f
} -body {
    list [catch {::blobulator::exportBlobCSV $target}] [exportRead $target] \
        [llength [glob -nocomplain -directory $::exportDir .blobulator-*]]
} -cleanup {exportCleanup} -result {1 original 0}

test export-1.9 {cleared or deleted molecules cannot export stale assignments} -setup {
    set molid [exportFixture]
} -body {
    ::blobulator::blobClear $molid
    set cleared [catch {::blobulator::exportContext}]
    mol delete $molid
    list $cleared [catch {::blobulator::exportContext}]
} -cleanup {exportCleanup} -result {1 1}

test export-1.10 {residue insertion codes survive export} -setup {
    exportFixture {A} {} 1
} -body {
    set target [file join $::exportDir insertion.csv]
    set count [::blobulator::exportBlobCSV $target]
    list $count [string match {*"6","A","GLU"*} [exportRead $target]]
} -cleanup {exportCleanup} -result {12 1}

test export-1.11 {an output directory cannot be mistaken for a file} -setup {
    exportFixture
} -body {
    list [catch {::blobulator::exportBlobCSV $::exportDir 1}] \
        [llength [glob -nocomplain -directory $::exportDir * .blobulator-*]]
} -cleanup {exportCleanup} -result {1 0}

test export-2.1 {PPM parsing preserves whitespace bytes at start of raster} -body {
    set pixels [binary format H* 0a200dff000000ff000000ff]
    set target [file join $::exportDir tiny.ppm]
    ::blobulator::writeExportFile $target "P6\n# comment\n2 2\n255\n$pixels" 1 0
    lassign [::blobulator::readExportPPM $target] width height actual
    list $width $height [expr {$actual eq $pixels}]
} -cleanup {exportCleanup} -result {2 2 1}

test export-2.2 {truncated render output is rejected} -body {
    set target [file join $::exportDir bad.ppm]
    ::blobulator::writeExportFile $target "P6\n2 2\n255\nabc" 1 0
    catch {::blobulator::readExportPPM $target}
} -cleanup {exportCleanup} -result 1

test export-2.3 {native PDF render preserves scene, coordinates and renderer format} -setup {
    set molid [exportFixture]
    set ::blobulator::smoothingWindow 3
    ::blobulator::applyTrajectorySmoothing
    display resize 240 180
} -body {
    set sel [atomselect $molid all]
    set before [$sel get {x y z user user2}]
    set view [molinfo $molid get {center_matrix rotate_matrix scale_matrix global_matrix}]
    set previous [render format TachyonInternal]
    set target [file join $::exportDir scene.pdf]
    ::blobulator::exportScenePDF $target
    set result [list [string match {%PDF-1.4*} [exportRead $target 1]] \
        [expr {$before eq [$sel get {x y z user user2}]}] \
        [expr {$view eq [molinfo $molid get {center_matrix rotate_matrix scale_matrix global_matrix}]}] \
        [expr {$previous eq [render format TachyonInternal]}] \
        [llength [glob -nocomplain -directory $::exportDir .blobulator-*]]]
    $sel delete
    set result
} -cleanup {exportCleanup} -result {1 1 1 1 0}

test export-2.4 {failed rendering restores format and preserves an existing output} -setup {
    exportFixture
    set target [file join $::exportDir existing.pdf]
    set f [open $target w]; puts -nonewline $f original; close $f
    set previous [render format TachyonInternal]
    rename render realRender
    proc render {args} {
        if {[lindex $args 0] eq "TachyonInternal"} {error "Rendering failed for test"}
        return [uplevel 1 [linsert $args 0 realRender]]
    }
} -body {
    list [catch {::blobulator::exportScenePDF $target 1}] [exportRead $target] \
        [expr {$previous eq [render format TachyonInternal]}] \
        [llength [glob -nocomplain -directory $::exportDir .blobulator-*]]
} -cleanup {
    rename render {}
    rename realRender render
    exportCleanup
} -result {1 original 1 0}

test export-3.1 {cancelled save creates no file and shows no error} -setup {
    exportFixture
    set ::saveFilename ""
    set ::dialogMessage ""
} -body {
    list [::blobulator::exportFromGUI csv] $::dialogMessage \
        [llength [glob -nocomplain -directory $::exportDir *]]
} -cleanup {exportCleanup} -result {0 {} 0}

test export-3.2 {GUI failures produce a useful dialog} -setup {
    exportFixture
    set ::saveFilename [file join $::exportDir absent output.csv]
    set ::dialogMessage ""
} -body {
    list [::blobulator::exportFromGUI csv] [expr {$::dialogMessage ne ""}]
} -cleanup {exportCleanup} -result {0 1}

test export-3.3 {reopening keeps the applied provenance} -setup {
    set molid [exportFixture]
} -body {
    set before $::blobulator::blobulationParameters($molid)
    source Blob_GUI.tcl
    list [expr {$before eq $::blobulator::blobulationParameters($molid)}] \
        [::blobulator::exportBlobCSV [file join $::exportDir reopened.csv]]
} -cleanup {exportCleanup} -result {1 12}

test export-3.4 {GUI CSV export saves data and reports the residue count} -setup {
    exportFixture
    set ::saveFilename [file join $::exportDir gui.csv]
    set ::dialogMessage ""
} -body {
    list [::blobulator::exportFromGUI csv] [file isfile $::saveFilename] \
        [string match {Saved 12 residues*} $::blobulator::exportStatus] $::dialogMessage
} -cleanup {exportCleanup} -result {1 1 1 {}}

set failed $::tcltest::numTests(Failed)
puts "BLOB_EXPORT_TEST_RESULT total=$::tcltest::numTests(Total) passed=$::tcltest::numTests(Passed) failed=$failed"
::tcltest::removeDirectory blob_export_test_output
cd $originalDir
::tcltest::cleanupTests
# VMD's quit command ignores an exit-status argument. A fresh Tcl interpreter
# retains Tcl's exit command, which reports failure correctly to test runners.
flush stdout
interp create exportTestExit
interp eval exportTestExit [list exit [expr {$failed > 0}]]
}
