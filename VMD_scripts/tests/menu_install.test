# Plain Tcl tests use a disposable startup file, never the user's ~/.vmdrc.
package require tcltest 2
namespace import ::tcltest::test
::tcltest::configure -verbose {start pass error}
set pluginDir [file dirname [file dirname [file normalize [info script]]]]
source [file join $pluginDir blobulator_plugin.tcl]
set output [::tcltest::makeDirectory menu_install_output]
proc menuRead {filename} {set f [open $filename rb];set data [read $f];close $f;return $data}
test menu-1.1 {registration source remains lazy and headless-safe} -body {
    list [package provide blobulator_gui] [llength [info commands ::blobulator::GUI]] [::blobulator::registerMenu]
} -result {1.1 0 0}
test menu-1.2 {a new startup file receives one correctly quoted source block} -body {
    set rc [file join $output fresh.vmdrc]
    set result [::blobulator::installMenuShortcut $rc]
    set data [menuRead $rc]
    list [dict get $result status] [dict get $result backup] \
        [regexp -all {BEGIN BLOBULATOR MENU} $data] [expr {[string first {blobulator_plugin.tcl} $data]>=0}]
} -result {installed {} 1 1}
test menu-1.3 {existing settings survive byte-for-byte and receive a backup} -body {
    set rc [file join $output existing.vmdrc]
    set f [open $rc wb];puts -nonewline $f "# custom settings\r\ndisplay projection orthographic";close $f
    set before [menuRead $rc]
    set result [::blobulator::installMenuShortcut $rc]
    list [expr {[menuRead [dict get $result backup]] eq $before}] \
        [expr {[string first $before [menuRead $rc]]==0}]
} -result {1 1}
test menu-1.4 {repeat installation is idempotent and creates no extra backup} -body {
    set rc [file join $output fresh.vmdrc]
    set before [menuRead $rc]
    set result [::blobulator::installMenuShortcut $rc]
    list [dict get $result status] [dict get $result backup] [expr {$before eq [menuRead $rc]}]
} -result {unchanged {} 1}
test menu-1.5 {an incomplete managed block leaves startup untouched} -body {
    set rc [file join $output broken.vmdrc]
    set f [open $rc wb];puts -nonewline $f {# BEGIN BLOBULATOR MENU};close $f
    set before [menuRead $rc]
    list [catch {::blobulator::installMenuShortcut $rc}] [expr {$before eq [menuRead $rc]}]
} -result {1 1}
test menu-1.6 {menu source paths containing spaces and Tcl metacharacters are quoted safely} -body {
    set rc [file join $output quoted.vmdrc]
    set previous $::blobulator::pluginDirectory
    set ::blobulator::pluginDirectory [file join $output {path with spaces [brackets]}]
    ::blobulator::installMenuShortcut $rc
    set ::blobulator::pluginDirectory $previous
    # The referenced file is absent, so evaluation must safely do nothing.
    list [catch {source $rc}] [regexp -all {BEGIN BLOBULATOR MENU} [menuRead $rc]]
} -result {0 1}
test menu-1.7 {registration happens once even when an unknown menu reports status zero} -setup {
    set calls {}
    proc winfo {args} {return 1}
    proc menu {args} {
        if {[lindex $args 0] eq "tk"} {lappend ::calls $args}
        return 0
    }
} -body {
    ::blobulator::registerMenu
    ::blobulator::registerMenu
    list [llength $calls] [lindex $calls 0]
} -cleanup {
    rename winfo {};rename menu {};unset -nocomplain ::blobulator::menuRegistered
} -result {1 {tk register blobulator_gui ::blobulator::openWindow Analysis/Blobulator}}
proc menuStartupProbe {startup defaults} {
    # Execute the generated file in isolation with a fake VMD API. Checking
    # registration alone misses the regression where VMD Main remains hidden.
    set child [interp create]
    set result [catch {
        $child eval [list set ::env(VMDDIR) $defaults]
        $child eval {
            set main off
            set defaultLoaded 0
            proc winfo {args} {return 1}
            proc menu {args} {
                if {$args eq {main on}} {set ::main on}
                return 0
            }
        }
        $child eval [list source $startup]
        $child eval {list $main $defaultLoaded}
    } message options]
    interp delete $child
    if {$result} {return -options $options $message}
    return $message
}
set defaults [file join $output defaults]
file mkdir $defaults
set f [open [file join $defaults .vmdrc] w]
puts $f {set ::defaultLoaded 1; menu main on}
close $f
test menu-1.8 {new startup files load VMD defaults and open VMD Main} -body {
    menuStartupProbe [file join $output fresh.vmdrc] $defaults
} -result {on 1}
test menu-1.9 {custom startup files keep their own window preferences} -body {
    set rc [file join $output custom.vmdrc]
    set f [open $rc w];puts $f {set ::customSetting preserved};close $f
    ::blobulator::installMenuShortcut $rc
    menuStartupProbe $rc $defaults
} -result {off 0}
test menu-1.10 {repair earlier plugin-only startup while keeping an exact backup} -body {
    set rc [file join $output legacy.vmdrc]
    set f [open $rc w]
    puts $f "# BEGIN BLOBULATOR MENU\n[list source [file join $pluginDir blobulator_plugin.tcl]]\n# END BLOBULATOR MENU"
    close $f
    set before [menuRead $rc]
    set result [::blobulator::installMenuShortcut $rc]
    list [menuStartupProbe $rc $defaults] \
        [expr {[menuRead [dict get $result backup]] eq $before}] \
        [dict get [::blobulator::installMenuShortcut $rc] status]
} -result {{on 1} 1 unchanged}
test menu-1.11 {refresh retains defaults and subsequently added user settings} -body {
    set rc [file join $output fresh.vmdrc]
    set f [open $rc a];puts $f {set ::laterSetting preserved};close $f
    ::blobulator::installMenuShortcut $rc
    list [menuStartupProbe $rc $defaults] \
        [expr {[string first {set ::laterSetting preserved} [menuRead $rc]] >= 0}]
} -result {{on 1} 1}
test menu-1.12 {VMD Main opens when the installation has no default startup file} -body {
    menuStartupProbe [file join $output fresh.vmdrc] [file join $output absent]
} -result {on 0}
set failed $::tcltest::numTests(Failed)
puts "BLOB_MENU_TEST_RESULT total=$::tcltest::numTests(Total) passed=$::tcltest::numTests(Passed) skipped=$::tcltest::numTests(Skipped) failed=$failed"
::tcltest::removeDirectory menu_install_output
::tcltest::cleanupTests
exit [expr {$failed>0}]
